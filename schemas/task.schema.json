{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-science-agent-network.local/schemas/task.schema.json",
  "title": "Open Science Agent Network Task",
  "type": "object",
  "required": [
    "task_id",
    "domain",
    "task_type",
    "title",
    "dataset_source",
    "source_license",
    "input_uri",
    "input_sha256",
    "objective",
    "caveats",
    "input",
    "review_questions",
    "expected_outputs"
  ],
  "additionalProperties": true,
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "task_type": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "dataset_source": { "type": "string", "minLength": 1 },
    "source_license": { "type": "string", "minLength": 1 },
    "input_uri": { "type": "string", "minLength": 1 },
    "input_sha256": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "caveats": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "input": {
      "type": "object",
      "minProperties": 1
    },
    "review_questions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
